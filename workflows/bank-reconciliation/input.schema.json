{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bank-reconciliation input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "cash_account": {
          "default": "1000 Operating Cash"
        },
        "period_start": {
          "default": ""
        },
        "period_end": {
          "default": ""
        },
        "date_window_days": {
          "default": 5
        },
        "bank_charge_keywords": {
          "default": [
            "fee",
            "charge",
            "interest",
            "service"
          ]
        },
        "bank_fee_account": {
          "default": "6900 Bank Charges"
        },
        "interest_income_account": {
          "default": "4900 Interest Income"
        },
        "statement_closing_balance": {
          "default": null
        },
        "book_closing_balance": {
          "default": null
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "bank_statement",
              "gl_cash"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
