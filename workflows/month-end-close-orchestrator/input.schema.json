{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "month-end-close-orchestrator input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "period_end": {
          "default": ""
        },
        "tolerance": {
          "default": 0.01
        },
        "suspense_accounts": {
          "default": [
            "suspense",
            "ask my accountant",
            "uncategorized",
            "clearing"
          ]
        },
        "checklist": {
          "default": [
            {
              "task": "Bank reconciliations",
              "owner": "AP lead",
              "check": "status"
            },
            {
              "task": "Accruals posted",
              "owner": "GL accountant",
              "check": "status"
            },
            {
              "task": "Payroll reconciled",
              "owner": "Payroll",
              "check": "status"
            },
            {
              "task": "Depreciation posted",
              "owner": "GL accountant",
              "check": "status"
            },
            {
              "task": "Trial balance balances",
              "owner": "Controller",
              "check": "tb_balances"
            },
            {
              "task": "Suspense accounts cleared",
              "owner": "Controller",
              "check": "suspense_zero"
            }
          ]
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "trial_balance",
              "task_status"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
