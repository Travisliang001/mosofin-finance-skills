{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pbc-chase-up input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "as_at": {
          "default": ""
        },
        "due_soon_days": {
          "default": 3
        },
        "engagement": {
          "default": "year-end audit"
        },
        "sender_name": {
          "default": "Finance"
        },
        "subject_template": {
          "default": "{{engagement}}: {{count}} open request(s) for you"
        },
        "body_template": {
          "default": "Hi {{owner}},\n\nFor the {{engagement}}, these requests are still open:\n\n{{lines}}\n\nPlease upload them or let me know what is holding them up.\n\nThanks,\n{{sender}}"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "pbc_list",
              "received"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
