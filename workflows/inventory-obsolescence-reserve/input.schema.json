{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory-obsolescence-reserve input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "as_at": {
          "default": ""
        },
        "aging_tiers": {
          "default": [
            {
              "days": 180,
              "reserve_pct": 25
            },
            {
              "days": 365,
              "reserve_pct": 50
            },
            {
              "days": 540,
              "reserve_pct": 100
            }
          ]
        },
        "never_sold_pct": {
          "default": 100
        },
        "existing_reserve": {
          "default": 0
        },
        "reserve_account": {
          "default": "1390 Inventory Reserve"
        },
        "expense_account": {
          "default": "5050 Inventory Obsolescence"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "items"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
