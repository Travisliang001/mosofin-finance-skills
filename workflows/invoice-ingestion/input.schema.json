{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice-ingestion input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "default_expense_account": {
          "default": "6999 Uncategorised: review"
        },
        "coding_rules": {
          "default": [
            {
              "keyword": "software|subscription|licen",
              "account": "6150 Software"
            },
            {
              "keyword": "freight|shipping|courier",
              "account": "5200 Freight In"
            },
            {
              "keyword": "rent|lease",
              "account": "6100 Rent"
            },
            {
              "keyword": "repair|maintenance",
              "account": "6170 Repairs and Maintenance"
            },
            {
              "keyword": "pallet|wrap|packag|corner board",
              "account": "5100 Packaging"
            }
          ]
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "invoice_lines",
              "vendors"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
