{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sales-tax-compliance-monitor input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "window_start": {
          "default": ""
        },
        "as_at": {
          "default": ""
        },
        "warn_pct": {
          "default": 80
        },
        "registered_states": {
          "default": []
        },
        "thresholds": {
          "default": {
            "default": {
              "amount": 100000,
              "transactions": 200
            },
            "CA": {
              "amount": 500000,
              "transactions": null
            },
            "TX": {
              "amount": 500000,
              "transactions": null
            },
            "NY": {
              "amount": 500000,
              "transactions": 100
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "sales"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
