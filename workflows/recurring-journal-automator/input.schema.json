{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recurring-journal-automator input envelope",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "description": "Per-run overrides of any setting.",
      "properties": {
        "company": {
          "default": ""
        },
        "currency": {
          "default": "USD"
        },
        "datasource": {
          "default": "quickbooks"
        },
        "data_source_id": {
          "default": ""
        },
        "period_start": {
          "default": ""
        },
        "period_end": {
          "default": ""
        },
        "drift_pct": {
          "default": 5
        },
        "recurring_rules": {
          "default": [
            {
              "name": "Office rent",
              "debit_account": "6100 Rent",
              "credit_account": "2000 Accounts Payable",
              "amount": 4400
            },
            {
              "name": "Monthly depreciation",
              "debit_account": "6800 Depreciation",
              "credit_account": "1590 Accumulated Depreciation",
              "amount": 3125
            },
            {
              "name": "Software subscriptions",
              "debit_account": "6150 Software",
              "credit_account": "2100 Accrued Liabilities",
              "amount": 7300
            }
          ]
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "gl"
            ]
          },
          "content": {
            "type": "string",
            "description": "CSV text, first row = headers"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "company": {
            "type": "string",
            "description": "company the file belongs to, if known"
          }
        }
      }
    }
  }
}
